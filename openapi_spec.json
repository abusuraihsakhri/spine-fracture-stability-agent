{
  "openapi": "3.1.0",
  "info": {
    "title": "Spine Fracture Stability Engine API",
    "description": "Reference-based TLICS/SLIC scoring with legacy generic threshold monitoring. The authoritative API schema is generated at /openapi.json.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON operational counters, not Prometheus text format"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy illustrative generic-threshold audit; not a clinical spine score",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock supervisory response; no model inference",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/score": {
      "post": {
        "summary": "Calculate one TLICS or SLIC categorical point score (educational use)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scale": {
                    "type": "string",
                    "enum": [
                      "TLICS",
                      "SLIC"
                    ]
                  },
                  "morphology": {
                    "type": "string"
                  },
                  "ligament": {
                    "type": "string"
                  },
                  "neurologic": {
                    "type": "string"
                  },
                  "ongoing_compression": {
                    "type": "boolean",
                    "default": false,
                    "description": "Optional SLIC only, with a neurologic deficit"
                  }
                },
                "required": [
                  "scale",
                  "morphology",
                  "ligament",
                  "neurologic"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Points by component, total, interpretation, and reference"
          },
          "422": {
            "description": "Missing or invalid input categories"
          }
        }
      }
    }
  }
}
